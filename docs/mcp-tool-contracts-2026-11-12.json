{
  "source": "Codex app-server MCP catalog for 0.11.1-candidate on 2026-11-12",
  "server": {
    "name": "simple-lsp-mcp",
    "title": "Simple LSP semantic code navigation",
    "version": "0.11.1-candidate",
    "description": null,
    "icons": null,
    "websiteUrl": "https://github.com/tamutamu/simple-lsp-mcp"
  },
  "tools": {
    "analyze_impact": {
      "name": "analyze_impact",
      "title": "Analyze impact",
      "description": "Recursive LSP reference graph. path+line; depth=1 direct, 2 next hop (default 8, max 16). Cycles and truncation reported.",
      "inputSchema": {
        "properties": {
          "depth": {
            "description": "1=direct, 2=next hop; default 8, maximum 16.",
            "minimum": 1,
            "type": "integer"
          },
          "line": {
            "description": "One-based line.",
            "minimum": 1,
            "type": "integer"
          },
          "max_nodes": {
            "description": "Maximum graph nodes; default 80, maximum 200.",
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "description": "Workspace-relative file path.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "line"
        ],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    "apply_code_action": {
      "name": "apply_code_action",
      "title": "Apply code action",
      "description": "Apply the selected action_id only when it resolves to the same WorkspaceEdit-backed action; commands are not executed.",
      "inputSchema": {
        "properties": {
          "action_id": {
            "description": "action_id returned by get_code_actions.",
            "type": "string"
          },
          "code_action_kinds": {
            "description": "Requested code-action kinds.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "column": {
            "description": "One-based column.",
            "minimum": 1,
            "type": "integer"
          },
          "end_column": {
            "description": "One-based range end column.",
            "minimum": 1,
            "type": "integer"
          },
          "end_line": {
            "description": "One-based range end line.",
            "minimum": 1,
            "type": "integer"
          },
          "language": {
            "description": "Language; target tools infer it when possible.",
            "enum": [
              "python",
              "typescript",
              "typescriptreact",
              "javascript",
              "javascriptreact",
              "go",
              "html",
              "css"
            ],
            "type": "string"
          },
          "line": {
            "description": "One-based line.",
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "description": "Workspace-relative file path.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "line",
          "column",
          "action_id"
        ],
        "type": "object"
      },
      "annotations": {
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
    "find_implementations": {
      "name": "find_implementations",
      "title": "Find implementations",
      "description": "LSP: implementation locations for a target.",
      "inputSchema": {
        "properties": {
          "column": {
            "description": "One-based column.",
            "minimum": 1,
            "type": "integer"
          },
          "language": {
            "description": "Language; target tools infer it when possible.",
            "enum": [
              "python",
              "typescript",
              "typescriptreact",
              "javascript",
              "javascriptreact",
              "go",
              "html",
              "css"
            ],
            "type": "string"
          },
          "limit": {
            "description": "Maximum results.",
            "minimum": 1,
            "type": "integer"
          },
          "line": {
            "description": "One-based line.",
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "description": "Workspace-relative file path.",
            "type": "string"
          },
          "relation_view": {
            "description": "locations (default): exact LSP positions; lines: also include a bounded source line at every result.",
            "enum": [
              "locations",
              "lines"
            ],
            "type": "string"
          },
          "symbol_id": {
            "description": "Previously returned symbol_id.",
            "type": "string"
          },
          "symbol_path": {
            "description": "Nested name, e.g. UserService/createUser. Add path to scope; leading / anchors.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    "find_references": {
      "name": "find_references",
      "title": "Find references",
      "description": "Exact LSP references to a declaration. relation_view=lines includes source text; exclude_test_files=true narrows to non-test files (opt-in), retaining the excluded count and filter scope. For production-only callers prefer no declaration, no test files.",
      "inputSchema": {
        "properties": {
          "column": {
            "description": "One-based column.",
            "minimum": 1,
            "type": "integer"
          },
          "exclude_test_files": {
            "description": "Opt-in: omit _test.go, test_*.py, *.test.ts/js and other known test paths from exact LSP references. Results report excluded_count; default false.",
            "type": "boolean"
          },
          "include_declaration": {
            "description": "Include declaration among references.",
            "type": "boolean"
          },
          "language": {
            "description": "Language; target tools infer it when possible.",
            "enum": [
              "python",
