    "inspect_symbol": {
      "name": "inspect_symbol",
      "title": "Inspect symbol",
      "description": "Inspect one exact declaration or batch verified targets[]. related[] returns only bounded context (maximum 20 per relation), never an exhaustive reference list. For all usages call find_references instead. If name is unknown, discover get_document_symbols(path) first; do not guess.",
