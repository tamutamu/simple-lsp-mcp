            "minimum": 1,
            "type": "integer"
          },
          "line": {
            "description": "One-based line.",
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "description": "Workspace-relative file path.",
            "type": "string"
          },
          "relation_view": {
